@model HeThongVanTai.Web.Models.ViewModels.DatVe.TripSearchViewModel
@using System.Globalization
@using HeThongVanTai.Web.Models.ViewModels.DatVe
@{
    ViewData["Title"] = "Tìm chuyến";
    var f = Model.Filter;
    var date = f.Date ?? DateTime.Today;
    var result = Model.Result;
    var totalPages = result == null || result.PageSize <= 0 ? 0 : (int)Math.Ceiling(result.Total / (double)result.PageSize);
    var hasAdvanced = f.FromHour.HasValue || f.ToHour.HasValue || f.VehicleTypeId.HasValue
                      || f.MinPrice.HasValue || f.MaxPrice.HasValue || !string.IsNullOrEmpty(f.Sort);

    // Giữ nguyên bộ lọc khi bấm sang trang khác
    Dictionary<string, string> PageRoute(int p)
    {
        var d = new Dictionary<string, string>
                {
                    ["fromStationId"] = f.FromStationId?.ToString() ?? "",
                    ["toStationId"] = f.ToStationId?.ToString() ?? "",
                    ["date"] = date.ToString("yyyy-MM-dd"),
                    ["tickets"] = f.Tickets.ToString(),
                    ["page"] = p.ToString()
                };
        if (f.FromHour.HasValue) d["fromHour"] = f.FromHour.Value.ToString();
        if (f.ToHour.HasValue) d["toHour"] = f.ToHour.Value.ToString();
        if (f.VehicleTypeId.HasValue) d["vehicleTypeId"] = f.VehicleTypeId.Value.ToString();
        if (f.MinPrice.HasValue) d["minPrice"] = f.MinPrice.Value.ToString(CultureInfo.InvariantCulture);
        if (f.MaxPrice.HasValue) d["maxPrice"] = f.MaxPrice.Value.ToString(CultureInfo.InvariantCulture);
        if (!string.IsNullOrWhiteSpace(f.Sort)) d["sort"] = f.Sort!;
        return d;
    }
}

<div class="container py-4">
    <h1 class="h3 fw-bold mb-3">Tìm chuyến xe</h1>

    <form method="get" asp-controller="Trips" asp-action="Search" class="card card-vt p-4 mb-4">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label small" for="fromStationId">Điểm đi</label>
                <select class="form-select" id="fromStationId" name="fromStationId" required>
                    <option value="">Chọn bến đi</option>
                    @foreach (var s in Model.Stations)
                    {
                        <option value="@s.Id" selected="@(f.FromStationId == s.Id)">@s.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small" for="toStationId">Điểm đến</label>
                <select class="form-select" id="toStationId" name="toStationId" required>
                    <option value="">Chọn bến đến</option>
                    @foreach (var s in Model.Stations)
                    {
                        <option value="@s.Id" selected="@(f.ToStationId == s.Id)">@s.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small" for="date">Ngày đi</label>
                <input type="date" class="form-control" id="date" name="date"
                       min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@date.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="col-md-3">
                <label class="form-label small" for="tickets">Số vé</label>
                <input type="number" class="form-control" id="tickets" name="tickets" min="1" max="10" value="@f.Tickets" required />
            </div>
        </div>

        <details class="mt-3" open="@hasAdvanced">
            <summary class="fw-semibold">Lọc và sắp xếp</summary>
            <div class="row g-3 mt-1">
                <div class="col-6 col-md-2">
                    <label class="form-label small" for="fromHour">Giờ đi từ</label>
                    <select class="form-select" id="fromHour" name="fromHour">
                        <option value="">Bất kỳ</option>
                        @for (var h = 0; h < 24; h++)
                        {
                            <option value="@h" selected="@(f.FromHour == h)">@h:00</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small" for="toHour">Đến trước</label>
                    <select class="form-select" id="toHour" name="toHour">
                        <option value="">Bất kỳ</option>
                        @for (var h = 0; h < 24; h++)
                        {
                            <option value="@h" selected="@(f.ToHour == h)">@h:59</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small" for="vehicleTypeId">Loại xe</label>
                    <select class="form-select" id="vehicleTypeId" name="vehicleTypeId">
                        <option value="">Tất cả</option>
                        @foreach (var vt in Model.VehicleTypes)
                        {
                            <option value="@vt.Id" selected="@(f.VehicleTypeId == vt.Id)">@vt.Name</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small" for="minPrice">Giá từ</label>
                    <input type="number" min="0" step="1000" class="form-control" id="minPrice" name="minPrice" value="@f.MinPrice" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small" for="maxPrice">Giá đến</label>
                    <input type="number" min="0" step="1000" class="form-control" id="maxPrice" name="maxPrice" value="@f.MaxPrice" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small" for="sort">Sắp xếp</label>
                    <select class="form-select" id="sort" name="sort">
                        <option value="" selected="@(string.IsNullOrEmpty(f.Sort))">Giờ đi sớm nhất</option>
                        <option value="price_asc" selected="@(f.Sort == "price_asc")">Giá thấp đến cao</option>
                        <option value="price_desc" selected="@(f.Sort == "price_desc")">Giá cao đến thấp</option>
                    </select>
                </div>
            </div>
        </details>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary px-4"><i class="bi bi-search me-1"></i>Tìm chuyến</button>
        </div>
    </form>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-danger">@Model.Error</div>
    }

    @if (result != null)
    {
        if (result.Total == 0)
        {
            <div class="alert alert-info">Không có chuyến nào phù hợp. Thử đổi ngày đi hoặc bỏ bớt bộ lọc.</div>
        }
        else
        {
            <p class="text-muted">Tìm thấy <strong>@result.Total</strong> chuyến ngày @date.ToString("dd/MM/yyyy")</p>

            foreach (var t in result.Items)
            {
                <div class="card card-vt mb-3">
                    <div class="card-body">
                        <div class="row align-items-center g-3">
                            <div class="col-md-5">
                                <div class="fw-bold">@t.Route</div>
                                <div class="fs-5">@t.DepartAt.ToString("HH:mm")@(t.ArriveAt.HasValue ? " - " + t.ArriveAt.Value.ToString("HH:mm") : "")</div>
                                <div class="small text-muted">@t.VehicleType, biển số @t.Plate</div>
                            </div>
                            <div class="col-md-3">
                                <div class="fs-5 fw-bold">@DatVeHelpers.Money(t.Price)</div>
                                @if (t.AvailableSeats >= f.Tickets)
                                {
                                    <span class="pill pill-ok">Còn @t.AvailableSeats / @t.TotalSeats chỗ</span>
                                }
                                else if (t.AvailableSeats > 0)
                                {
                                    <span class="pill pill-warn">Chỉ còn @t.AvailableSeats chỗ</span>
                                }
                                else
                                {
                                    <span class="pill pill-bad">Hết chỗ</span>
                                }
                            </div>
                            <div class="col-md-4 text-md-end">
                                @if (t.AvailableSeats >= f.Tickets)
                                {
                                    <a class="btn btn-primary" asp-action="Seats" asp-route-id="@t.TripId" asp-route-tickets="@f.Tickets">Chọn ghế</a>
                                }
                                else
                                {
                                    <button class="btn btn-outline-primary" disabled>Không đủ chỗ</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }

            if (totalPages > 1)
            {
                <nav aria-label="Phân trang">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(result.Page <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Search" asp-all-route-data="PageRoute(result.Page - 1)">Trước</a>
                        </li>
                        @for (var p = Math.Max(1, result.Page - 2); p <= Math.Min(totalPages, result.Page + 2); p++)
                        {
                            <li class="page-item @(p == result.Page ? "active" : "")">
                                <a class="page-link" asp-action="Search" asp-all-route-data="PageRoute(p)">@p</a>
                            </li>
                        }
                        <li class="page-item @(result.Page >= totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Search" asp-all-route-data="PageRoute(result.Page + 1)">Sau</a>
                        </li>
                    </ul>
                </nav>
            }
        }
    }
</div>