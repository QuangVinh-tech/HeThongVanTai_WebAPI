@model RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
}

<div class="container auth-wrap">
    <div class="card card-vt p-4">
        <h1 class="h4 mb-3">Đăng ký tài khoản</h1>
        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
            <div class="form-check mb-3">
                <input asp-for="AcceptTerms" class="form-check-input" />
                <label asp-for="AcceptTerms" class="form-check-label small">
                    Tôi đã đọc và đồng ý với <a asp-controller="Info" asp-action="Terms" target="_blank">Điều khoản sử dụng</a>
                    và <a asp-controller="Info" asp-action="Privacy" target="_blank">Chính sách bảo mật</a>,
                    bao gồm việc xử lý dữ liệu cá nhân của tôi để cung cấp dịch vụ đặt vé.
                </label>
                <div><span asp-validation-for="AcceptTerms" class="text-danger small"></span></div>
            </div>
            <button type="submit" class="btn btn-primary w-100">Đăng ký</button>
        </form>
        <p class="small mt-3 mb-0 text-center">
            Đã có tài khoản? <a asp-action="Login">Đăng nhập</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
