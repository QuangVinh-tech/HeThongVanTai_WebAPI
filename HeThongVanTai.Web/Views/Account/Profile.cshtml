@using HeThongVanTai.Web.Models.ViewModels.Users
@model ProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}

<div class="container py-4" style="max-width: 920px;">
    <h1 class="h4 mb-3">Hồ sơ cá nhân</h1>

    @if (!string.IsNullOrEmpty(Model.LoadError))
    {
        <div class="alert alert-warning py-2">@Model.LoadError</div>
    }

    <div class="row g-3">
        <div class="col-12 col-md-6">
            <div class="card card-vt p-4 h-100">
                <h2 class="h6 mb-3">Thông tin tài khoản</h2>
                <div class="mb-3">
                    <div class="small text-muted">Email đăng nhập</div>
                    <div class="fw-semibold text-break">@Model.Email</div>
                </div>
                <div>
                    <div class="small text-muted mb-1">Vai trò</div>
                    @if (Model.Roles.Count == 0)
                    {
                        <span class="text-muted">Chưa có vai trò</span>
                    }
                    else
                    {
                        foreach (var r in Model.Roles.OrderBy(x => x))
                        {
                            <span class="pill pill-info me-1">@RoleLabels.Of(r)</span>
                        }
                    }
                </div>
                <p class="small text-muted mt-3 mb-0">Vai trò do quản trị viên gán. Muốn đổi vai trò, hãy liên hệ quản trị viên.</p>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="card card-vt p-4 h-100">
                <h2 class="h6 mb-3">Đổi mật khẩu</h2>
                <form asp-action="ChangePassword" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                    <div class="mb-3">
                        <label asp-for="Password.CurrentPassword" class="form-label"></label>
                        <input asp-for="Password.CurrentPassword" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Password.CurrentPassword" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password.NewPassword" class="form-label"></label>
                        <input asp-for="Password.NewPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Password.NewPassword" class="text-danger small"></span>
                        <div class="form-text">Tối thiểu 6 ký tự, khác mật khẩu hiện tại.</div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password.ConfirmPassword" class="form-label"></label>
                        <input asp-for="Password.ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Password.ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">Đổi mật khẩu</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
