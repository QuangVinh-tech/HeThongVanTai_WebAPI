@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="container auth-wrap">
    <div class="card card-vt p-4">
        <h1 class="h4 mb-2">Quên mật khẩu</h1>

        @if (ViewData["Sent"] is string sent)
        {
            <div class="alert alert-success py-2">@sent</div>
            <p class="small text-muted">
                Hãy mở email và bấm vào liên kết để đặt mật khẩu mới. Nếu không thấy email, kiểm tra thư mục thư rác.
                Bạn có thể yêu cầu lại sau 1 phút.
            </p>
        }
        else
        {
            <p class="small text-muted">Nhập email đăng ký tài khoản. Chúng tôi sẽ gửi liên kết để bạn đặt lại mật khẩu.</p>
        }

        <form asp-action="ForgotPassword" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" autofocus />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Gửi liên kết đặt lại mật khẩu</button>
        </form>
        <p class="small mt-3 mb-0 text-center"><a asp-action="Login">Quay lại đăng nhập</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
