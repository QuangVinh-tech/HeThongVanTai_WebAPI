@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    var invalid = ViewData["InvalidLink"] is true;
}

<div class="container auth-wrap">
    <div class="card card-vt p-4">
        <h1 class="h4 mb-2">Đặt lại mật khẩu</h1>

        @if (invalid)
        {
            <div class="alert alert-danger py-2">Liên kết đặt lại mật khẩu không hợp lệ.</div>
            <a asp-action="ForgotPassword" class="btn btn-primary w-100">Yêu cầu liên kết mới</a>
        }
        else
        {
            <p class="small text-muted">Đặt mật khẩu mới cho <strong class="text-break">@Model.Email</strong>.</p>
            <form asp-action="ResetPassword" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Token" />
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" autofocus />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    <div class="form-text">Tối thiểu 6 ký tự.</div>
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100">Đặt lại mật khẩu</button>
            </form>
            @if (ViewData["ShowRequestNew"] is true)
            {
                <p class="small mt-3 mb-0 text-center">Liên kết hết hạn hoặc đã dùng? <a asp-action="ForgotPassword">Yêu cầu liên kết mới</a></p>
            }
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
