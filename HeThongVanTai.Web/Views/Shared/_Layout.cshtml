@inject HeThongVanTai.Web.Services.SettingsApiService SettingsApi
@{ var site = await SettingsApi.GetPublicAsync(); }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - VậnTải HK</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark navbar-vt">
            <div class="container">
                <a class="navbar-brand fw-bold brand-vt" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-bus-front-fill me-1"></i>VậnTải HK
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>

                        @* Thông tin: lịch trình, văn phòng, liên hệ, chính sách, tuyển dụng *@
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Thông tin</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Info" asp-action="Schedule">Lịch trình tuyến</a></li>
                                <li><a class="dropdown-item" asp-controller="Info" asp-action="Offices">Văn phòng và bến xe</a></li>
                                <li><a class="dropdown-item" asp-controller="Info" asp-action="Policy">Chính sách</a></li>
                                <li><a class="dropdown-item" asp-controller="Info" asp-action="Terms">Điều khoản sử dụng</a></li>
                                <li><a class="dropdown-item" asp-controller="Info" asp-action="Privacy">Chính sách bảo mật</a></li>
                                <li><a class="dropdown-item" asp-controller="Info" asp-action="Careers">Tuyển dụng</a></li>
                                <li><a class="dropdown-item" asp-controller="Info" asp-action="Contact">Liên hệ</a></li>
                            </ul>
                        </li>

                        @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Operator))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">Quản trị</a>
                            </li>
                        }
                        else if (User.IsInRole(AppRoles.Accountant))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Reports" asp-action="Index">Báo cáo</a>
                            </li>
                        }

                        @if (User.IsInRole(AppRoles.Seller) && !User.IsInRole(AppRoles.Admin))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="AdminBookings" asp-action="Index">Quản lý đặt vé</a>
                            </li>
                        }

                        @if (User.IsInRole(AppRoles.Driver))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="DriverTrips" asp-action="Index">Chuyến của tôi</a>
                            </li>
                        }

                        @* Soát vé: Admin, Điều hành, Bán vé, Tài xế *@
                        @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Operator)
                        || User.IsInRole(AppRoles.Seller) || User.IsInRole(AppRoles.Driver))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="CheckIn" asp-action="Index">Soát vé</a>
                            </li>
                        }

                        @* Gửi hàng: đứng trước (bên trái) Vé của tôi. Ai cũng thấy; mục cần đăng nhập chỉ hiện khi đã đăng nhập *@
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Gửi hàng
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Shipments" asp-action="Quote">Tính cước nhanh</a></li>
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <li><a class="dropdown-item" asp-controller="Shipments" asp-action="Create">Tạo đơn gửi hàng</a></li>
                                    <li><a class="dropdown-item" asp-controller="Shipments" asp-action="Mine">Đơn hàng của tôi (lịch sử)</a></li>
                                }
                                <li><a class="dropdown-item" asp-controller="Shipments" asp-action="Track">Tra cứu đơn hàng</a></li>
                            </ul>
                        </li>

                        @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Seller) || User.IsInRole(AppRoles.Customer))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="VeCuaToi" asp-action="Index">Vé của tôi</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="TraCuuVe" asp-action="Index">Tra cứu vé</a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav align-items-lg-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">Hồ sơ cá nhân</a></li>
                                    @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Seller) || User.IsInRole(AppRoles.Customer))
                                    {
                                        <li><a class="dropdown-item" asp-controller="VeCuaToi" asp-action="Index">Vé của tôi</a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                    }
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item">Đăng xuất</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item mt-2 mt-lg-0">
                                <a class="btn btn-outline-light btn-sm fw-semibold btn-login" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                            </li>
                            <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
                                <a class="btn btn-light btn-sm fw-semibold btn-register" asp-controller="Account" asp-action="Register">Đăng ký</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @if (TempData["Success"] is string successMessage)
    {
        <div class="container mt-3">
            <div class="alert alert-success alert-vt alert-dismissible fade show mb-0" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@successMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        </div>
    }

    @if (TempData["Error"] is string errorMessage)
    {
        <div class="container mt-3">
            <div class="alert alert-danger alert-vt alert-dismissible fade show mb-0" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        </div>
    }

    <main role="main" class="flex-grow-1 pb-4">
        @RenderBody()
    </main>

    <footer class="footer-vt mt-auto">
        @{
            var hotlineDigits = new string((site.Hotline ?? "").Where(char.IsDigit).ToArray());
        }
        <div class="container footer-main">
            <div class="row g-4">
                <div class="col-12 col-lg-5">
                    <div class="footer-heading">TRUNG TÂM TỔNG ĐÀI &amp; CSKH</div>
                    @if (!string.IsNullOrWhiteSpace(site.Hotline))
                    {
                        <a class="footer-hotline" href="tel:@hotlineDigits">@site.Hotline</a>
                    }
                    <div class="footer-company">@site.CompanyName</div>
                    <ul class="list-unstyled footer-contact mb-0">
                        @if (!string.IsNullOrWhiteSpace(site.Email))
                        {
                            <li><span class="footer-label">Email:</span> <a href="mailto:@site.Email">@site.Email</a></li>
                        }
                        @if (!string.IsNullOrWhiteSpace(site.Hotline))
                        {
                            <li><span class="footer-label">Điện thoại:</span> @site.Hotline</li>
                        }
                        <li><span class="footer-label">Văn phòng và bến xe:</span> <a asp-controller="Info" asp-action="Offices">Xem mạng lưới văn phòng</a></li>
                    </ul>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="footer-heading">@site.CompanyName</div>
                    <ul class="footer-links">
                        <li><a asp-controller="Info" asp-action="Schedule">Lịch trình</a></li>
                        <li><a asp-controller="Info" asp-action="Offices">Mạng lưới văn phòng</a></li>
                        <li><a asp-controller="Info" asp-action="Careers">Tuyển dụng</a></li>
                        <li><a asp-controller="Info" asp-action="Privacy">Chính sách bảo mật</a></li>
                        <li><a asp-controller="Info" asp-action="Contact">Liên hệ</a></li>
                    </ul>
                </div>

                <div class="col-6 col-lg-4">
                    <div class="footer-heading">Hỗ trợ</div>
                    <ul class="footer-links">
                        <li><a asp-controller="TraCuuVe" asp-action="Index">Tra cứu thông tin đặt vé</a></li>
                        <li><a asp-controller="Info" asp-action="Terms">Điều khoản sử dụng</a></li>
                        <li><a asp-controller="Info" asp-action="Policy">Chính sách đổi vé, hủy vé và hoàn tiền</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container">
                &copy; @DateTime.Now.Year <span class="footer-sep">|</span> Bản quyền thuộc về @site.CompanyName
                @if (!string.IsNullOrWhiteSpace(site.Hotline)) { <text><span class="footer-sep">|</span> Hotline: @site.Hotline</text> }
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>