@model ErrorViewModel
@{
    ViewData["Title"] = "Có lỗi xảy ra";
}

<div class="container py-5 text-center">
    <h1 class="h3">Có lỗi xảy ra</h1>
    <p>Hệ thống gặp sự cố khi xử lý yêu cầu của bạn. Vui lòng thử lại sau.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Mã yêu cầu: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Về trang chủ</a>
</div>
