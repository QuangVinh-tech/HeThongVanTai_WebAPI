@using HeThongVanTai.Web.Models.ViewModels.DanhMuc
@model List<StationItem>
@{
    ViewData["Title"] = "Bến xe";
    Layout = "_AdminLayout";
    var keyword = ViewData["Keyword"] as string;
    var city = ViewData["City"] as string;
    var loadError = ViewData["LoadError"] as string;
    var filtering = !string.IsNullOrWhiteSpace(keyword) || !string.IsNullOrWhiteSpace(city);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0">Bến xe</h1>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Thêm bến xe</a>
</div>

<form method="get" class="filter-vt row g-2 align-items-end mb-3">
    <div class="col-12 col-md-5">
        <label class="form-label small mb-1" for="keyword">Tìm theo tên hoặc địa chỉ</label>
        <input id="keyword" name="keyword" value="@keyword" class="form-control" />
    </div>
    <div class="col-12 col-md-4">
        <label class="form-label small mb-1" for="city">Thành phố</label>
        <input id="city" name="city" value="@city" class="form-control" />
    </div>
    <div class="col-12 col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-grow-1">Lọc</button>
        @if (filtering)
        {
            <a class="btn btn-outline-primary" asp-action="Index">Bỏ lọc</a>
        }
    </div>
</form>

@if (!string.IsNullOrEmpty(loadError))
{
    <div class="alert alert-danger">@loadError</div>
}

<div class="card card-vt">
    @if (Model.Count == 0)
    {
        <div class="p-4 text-center text-muted">
            @(filtering ? "Không có bến xe nào khớp với điều kiện lọc." : "Chưa có bến xe nào. Hãy thêm bến xe đầu tiên.")
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-vt table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Tên bến xe</th>
                        <th>Thành phố</th>
                        <th>Địa chỉ</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@s.Name</td>
                            <td>@s.City</td>
                            <td>@s.Address</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@s.Id">Sửa</a>
                                <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline"
                                      data-confirm="@("Xóa bến xe " + s.Name + "?")">
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Xóa</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/danh-muc.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ConfirmDeleteScript" />
}
