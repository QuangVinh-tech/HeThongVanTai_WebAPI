@using HeThongVanTai.Web.Models.ViewModels.DanhMuc
@model StationForm
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Thêm bến xe" : "Sửa bến xe";
    Layout = "_AdminLayout";
}

<h1 class="h4 mb-3">@ViewData["Title"]</h1>

<div class="card card-vt p-4 form-narrow">
    <form method="post" asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? (int?)null : Model.Id)">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" maxlength="100" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="City" class="form-label"></label>
            <input asp-for="City" class="form-control" maxlength="100" />
            <span asp-validation-for="City" class="text-danger small"></span>
        </div>
        <div class="mb-4">
            <label asp-for="Address" class="form-label"></label>
            <input asp-for="Address" class="form-control" maxlength="255" />
            <span asp-validation-for="Address" class="text-danger small"></span>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Lưu</button>
            <a class="btn btn-outline-primary" asp-action="Index">Hủy</a>
        </div>
    </form>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/danh-muc.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
