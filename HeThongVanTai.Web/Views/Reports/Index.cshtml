@using System.Globalization
@using System.Text.Json
@using HeThongVanTai.Web.Models.ViewModels.Reports
@model ReportViewModel
@{
    ViewData["Title"] = "Báo cáo doanh thu";
    Layout = "_AdminLayout";
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    var f = Model.Filter;
    var data = Model.Data;
    var fromText = f.From.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var toText = f.To.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    string Money(decimal value) => string.Format(vi, "{0:N0} đ", value);

    // Các cột sắp xếp: bấm tiêu đề để sắp xếp, bấm lần nữa để đảo chiều
    var columns = new[]
    {
        (Key: "route", Label: "Tuyến", Right: false),
        (Key: "payments", Label: "Số giao dịch", Right: true),
        (Key: "tickets", Label: "Số vé", Right: true),
        (Key: "revenue", Label: "Doanh thu", Right: true)
    };

    var totalPages = data?.TotalPages ?? 1;
    var current = Math.Min(Math.Max(f.Page, 1), totalPages);
    var pageFrom = Math.Max(1, current - 2);
    var pageTo = Math.Min(totalPages, current + 2);
}

@section Styles {
    <link rel="stylesheet" href="~/css/reports.css" asp-append-version="true" />
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0">Báo cáo doanh thu theo tuyến</h1>
</div>

<partial name="_ReportTabs" model='"route"' />

<form method="get" class="filter-vt row g-2 align-items-end mb-3">
    <div class="col-6 col-md-3">
        <label class="form-label small mb-1" for="from">Từ ngày</label>
        <input id="from" name="from" type="date" value="@fromText" class="form-control" />
    </div>
    <div class="col-6 col-md-3">
        <label class="form-label small mb-1" for="to">Đến ngày</label>
        <input id="to" name="to" type="date" value="@toText" class="form-control" />
    </div>
    <div class="col-12 col-md-3">
        <label class="form-label small mb-1" for="routeId">Tuyến</label>
        <select id="routeId" name="routeId" class="form-select">
            <option value="">Tất cả tuyến</option>
            @foreach (var r in Model.Routes)
            {
                <option value="@r.Id" selected="@(f.RouteId == r.Id)">@r.Name</option>
            }
        </select>
    </div>
    <div class="col-12 col-md-3 d-flex gap-2">
        <input type="hidden" name="sort" value="@f.Sort" />
        <input type="hidden" name="desc" value="@(f.Desc ? "true" : "false")" />
        <button type="submit" class="btn btn-primary flex-grow-1">Lọc</button>
        <a class="btn btn-outline-primary text-nowrap" title="Tải file Excel theo điều kiện lọc hiện tại"
           asp-action="Export" asp-route-from="@fromText" asp-route-to="@toText" asp-route-routeId="@f.RouteId"
           asp-route-sort="@f.Sort" asp-route-desc="@(f.Desc ? "true" : "false")">
            <i class="bi bi-file-earmark-excel me-1"></i>Xuất Excel
        </a>
    </div>
</form>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

@if (data != null)
{
    <div class="row g-3 mb-3">
        <div class="col-12 col-md-4">
            <div class="card card-vt p-3 h-100">
                <div class="small text-muted">Tổng doanh thu</div>
                <div class="report-value">@Money(data.Summary.TotalRevenue)</div>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="card card-vt p-3 h-100">
                <div class="small text-muted">Số vé bán</div>
                <div class="report-value">@data.Summary.TotalTickets.ToString("N0", vi)</div>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="card card-vt p-3 h-100">
                <div class="small text-muted">Số giao dịch</div>
                <div class="report-value">@data.Summary.TotalPayments.ToString("N0", vi)</div>
            </div>
        </div>
    </div>

    @if (data.Items.Count > 0 && data.Items.Any(i => i.Revenue != 0))
    {
        <div class="card card-vt chart-card">
            <div class="chart-box"><canvas id="reportChart" role="img" aria-label="Biểu đồ doanh thu theo tuyến"></canvas></div>
            <div class="report-sub mt-2">Biểu đồ theo các dòng của trang hiện tại trong bảng bên dưới.</div>
        </div>
        <script id="chartData" type="application/json">@Html.Raw(JsonSerializer.Serialize(new
        {
            kind = "bar-h",
            labels = data.Items.Select(i => i.RouteName),
            values = data.Items.Select(i => i.Revenue)
        }))</script>
    }

    <div class="card card-vt">
        @if (data.Items.Count == 0)
        {
            <div class="p-4 text-center text-muted">Không có doanh thu nào trong khoảng thời gian và tuyến đã chọn.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-vt table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            @foreach (var c in columns)
                            {
                                var active = f.Sort == c.Key;
                                // Bấm cột đang sắp xếp thì đảo chiều; cột khác thì mặc định giảm dần (tuyến: tăng dần)
                                var nextDesc = active ? !f.Desc : c.Key != "route";
                                <th class="@(c.Right ? "text-end" : "")">
                                    <a class="sort-link" asp-action="Index"
                                       asp-route-from="@fromText" asp-route-to="@toText" asp-route-routeId="@f.RouteId"
                                       asp-route-sort="@c.Key" asp-route-desc="@(nextDesc ? "true" : "false")">
                                        @c.Label
                                        @if (active)
                                        {
                                            <i class="bi @(f.Desc ? "bi-caret-down-fill" : "bi-caret-up-fill") ms-1"></i>
                                        }
                                    </a>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in data.Items)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@row.RouteName</div>
                                    <div class="small text-muted">@row.FromStation → @row.ToStation</div>
                                </td>
                                <td class="text-end">@row.Payments.ToString("N0", vi)</td>
                                <td class="text-end">@row.Tickets.ToString("N0", vi)</td>
                                <td class="text-end fw-semibold">@Money(row.Revenue)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @if (totalPages > 1)
    {
        <nav class="mt-3" aria-label="Phân trang">
            <ul class="pagination pagination-vt justify-content-center flex-wrap mb-0">
                <li class="page-item @(current == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-from="@fromText" asp-route-to="@toText" asp-route-routeId="@f.RouteId"
                       asp-route-sort="@f.Sort" asp-route-desc="@(f.Desc ? "true" : "false")" asp-route-page="@(current - 1)">Trước</a>
                </li>
                @for (var p = pageFrom; p <= pageTo; p++)
                {
                    <li class="page-item @(p == current ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-from="@fromText" asp-route-to="@toText" asp-route-routeId="@f.RouteId"
                           asp-route-sort="@f.Sort" asp-route-desc="@(f.Desc ? "true" : "false")" asp-route-page="@p">@p</a>
                    </li>
                }
                <li class="page-item @(current == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-from="@fromText" asp-route-to="@toText" asp-route-routeId="@f.RouteId"
                       asp-route-sort="@f.Sort" asp-route-desc="@(f.Desc ? "true" : "false")" asp-route-page="@(current + 1)">Sau</a>
                </li>
            </ul>
        </nav>
    }
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script src="~/js/report-chart.js" asp-append-version="true"></script>
}
