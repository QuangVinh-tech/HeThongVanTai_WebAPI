@using HeThongVanTai.Web.Models.ViewModels.DanhMuc
@model List<StationItem>
@{
    ViewData["Title"] = "Văn phòng và bến xe";
    var groups = Model.GroupBy(s => string.IsNullOrWhiteSpace(s.City) ? "Khác" : s.City!).OrderBy(g => g.Key);
}

<div class="container py-4">
    <h1 class="h3 fw-bold mb-1">Văn phòng và bến xe</h1>
    <p class="text-muted">Danh sách bến xe theo tỉnh thành.</p>

    @if (ViewData["Error"] is string err && !string.IsNullOrEmpty(err))
    {
        <div class="alert alert-danger">@err</div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">Chưa có bến xe nào.</div>
    }

    @foreach (var g in groups)
    {
        <h2 class="h5 fw-bold mt-4 mb-2"><i class="bi bi-geo-alt-fill me-1"></i>@g.Key</h2>
        <div class="row g-3">
            @foreach (var s in g.OrderBy(x => x.Name))
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card card-vt h-100 p-3">
                        <div class="fw-semibold">@s.Name</div>
                        <div class="small text-muted">@(string.IsNullOrWhiteSpace(s.Address) ? "Chưa cập nhật địa chỉ" : s.Address)</div>
                    </div>
                </div>
            }
        </div>
    }
</div>