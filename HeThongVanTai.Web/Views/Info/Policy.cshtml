@{
    ViewData["Title"] = "Chính sách";
}

<div class="container py-4" style="max-width: 820px;">
    <h1 class="h3 fw-bold mb-3">Chính sách</h1>

    <div class="card card-vt p-4 mb-3">
        <h2 class="h5 fw-bold">Hủy vé và hoàn tiền</h2>
        <p class="mb-2">Số tiền hoàn lại phụ thuộc vào thời điểm bạn hủy so với giờ xe chạy:</p>
        <div class="table-responsive">
            <table class="table table-vt mb-0">
                <thead><tr><th>Thời điểm hủy</th><th class="text-end">Hoàn lại</th></tr></thead>
                <tbody>
                    <tr><td>Từ 24 giờ trở lên trước giờ chạy</td><td class="text-end">100%</td></tr>
                    <tr><td>Từ 12 đến dưới 24 giờ</td><td class="text-end">70%</td></tr>
                    <tr><td>Từ 2 đến dưới 12 giờ</td><td class="text-end">50%</td></tr>
                    <tr><td>Dưới 2 giờ</td><td class="text-end">0%</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="card card-vt p-4 mb-3">
        <h2 class="h5 fw-bold">Đổi vé</h2>
        <p class="mb-0">Bạn có thể đổi ghế hoặc đổi sang chuyến khác cùng tuyến, với điều kiện đổi trước giờ chạy ít nhất 2 giờ.</p>
    </div>

    <div class="card card-vt p-4 mb-3">
        <h2 class="h5 fw-bold">Giữ chỗ</h2>
        <p class="mb-0">Sau khi đặt, ghế chỉ được giữ trong một thời gian ngắn để bạn hoàn tất. Hết thời gian giữ chỗ, ghế sẽ được mở lại cho khách khác.</p>
    </div>

    <div class="card card-vt p-4">
        <h2 class="h5 fw-bold">Chính sách khác</h2>
        <p class="mb-0 text-muted">[Bổ sung: hành lý, trẻ em, gửi hàng, bảo mật thông tin...]</p>
    </div>
</div>