@using HeThongVanTai.Web.Models.ViewModels.DanhMuc
@model List<RouteItem>
@{
    ViewData["Title"] = "Tuyến đường";
    Layout = "_AdminLayout";
    var loadError = ViewData["LoadError"] as string;

    string Duration(int minutes)
    {
        var h = minutes / 60;
        var m = minutes % 60;
        if (h == 0) return $"{m} phút";
        return m == 0 ? $"{h} giờ" : $"{h} giờ {m} phút";
    }
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0">Tuyến đường</h1>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Thêm tuyến đường</a>
</div>

@if (!string.IsNullOrEmpty(loadError))
{
    <div class="alert alert-danger">@loadError</div>
}

<div class="card card-vt">
    @if (Model.Count == 0)
    {
        <div class="p-4 text-center text-muted">Chưa có tuyến đường nào. Hãy thêm bến xe trước, rồi thêm tuyến đường.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-vt table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Tên tuyến</th>
                        <th>Bến đi</th>
                        <th>Bến đến</th>
                        <th class="text-end">Quãng đường</th>
                        <th class="text-end">Thời gian</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@r.Name</td>
                            <td>@r.FromStationName<div class="small text-muted">@r.FromCity</div></td>
                            <td>@r.ToStationName<div class="small text-muted">@r.ToCity</div></td>
                            <td class="text-end">@r.DistanceKm.ToString("N0") km</td>
                            <td class="text-end">@Duration(r.DurationMin)</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@r.Id">Sửa</a>
                                <form asp-action="Delete" asp-route-id="@r.Id" method="post" class="d-inline"
                                      data-confirm="@("Xóa tuyến " + r.Name + "?")">
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Xóa</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/danh-muc.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ConfirmDeleteScript" />
}
