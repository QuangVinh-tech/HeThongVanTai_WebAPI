@model HeThongVanTai.Web.Models.ViewModels.DatVe.PayViewModel
@using HeThongVanTai.Web.Models.ViewModels.DatVe
@{
    ViewData["Title"] = "Thanh toán";
    var b = Model.Booking;
}
@section Styles {
    <link rel="stylesheet" href="~/css/dat-ve.css" asp-append-version="true" />
}

<div class="container py-4">
    <h1 class="h3 fw-bold mb-3">Thanh toán</h1>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card card-vt p-4 mb-3 text-center">
                <div class="text-muted">Thời gian giữ ghế còn lại</div>
                <div class="hold-timer" id="timer" data-seconds="@Model.RemainingSeconds" aria-live="polite">--:--</div>
                <div class="small text-muted">Hết giờ, ghế được trả lại và bạn cần chọn lại.</div>
            </div>

            <div class="card card-vt p-4">
                <h2 class="h5 mb-3">Thanh toán</h2>

                @if (!string.IsNullOrWhiteSpace(Model.QrUrl))
                {
                    <div class="text-center mb-3">
                        <img src="@Model.QrUrl" alt="Mã QR chuyển khoản đặt vé @b.Code" width="260" height="260" />
                        <dl class="small text-start d-inline-block mt-2 mb-0">
                            <dt>Ngân hàng</dt><dd>@Model.BankId</dd>
                            <dt>Số tài khoản</dt><dd class="fw-semibold">@Model.AccountNo</dd>
                            @if (!string.IsNullOrWhiteSpace(Model.AccountName))
                            {
                                <dt>Chủ tài khoản</dt><dd>@Model.AccountName</dd>
                            }
                            <dt>Số tiền</dt><dd class="fw-semibold">@DatVeHelpers.Money(b.TotalAmount)</dd>
                            <dt>Nội dung</dt><dd class="fw-semibold">@b.Code</dd>
                        </dl>
                    </div>
                }
                else
                {
                    <div class="small mb-3">Chuyển khoản với nội dung <strong>@b.Code</strong>. (Chưa cấu hình tài khoản nhận tiền nên chưa có mã QR.)</div>
                }

                <div class="alert alert-info small" id="pay-status" aria-live="polite">
                    Quét mã QR bằng ứng dụng ngân hàng. Số tiền <strong>@DatVeHelpers.Money(b.TotalAmount)</strong> và
                    nội dung <strong>@b.Code</strong> đã điền sẵn, vui lòng <strong>không sửa</strong>.
                    <strong>Không cần bấm gì thêm</strong>: khi tiền về tài khoản, trang này tự chuyển sang vé của bạn.
                    @if (!string.IsNullOrWhiteSpace(Model.BankInfo))
                    {
                        <div class="mt-1">@Model.BankInfo</div>
                    }
                </div>

                @if (Model.IsStaff)
                {
                    <form method="post" asp-controller="Bookings" asp-action="Pay" asp-route-id="@b.Id" class="border-top pt-3">
                        <div class="small text-muted mb-2">Dành cho nhân viên quầy:</div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="method" id="m-cash" value="Cash" checked />
                            <label class="form-check-label" for="m-cash">Tiền mặt (thu tại quầy, xác nhận ngay)</label>
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="radio" name="method" id="m-bank" value="BankTransfer" />
                            <label class="form-check-label" for="m-bank">Chuyển khoản (khách quét mã QR ở trên, tự xác nhận khi tiền về)</label>
                        </div>
                        <button type="submit" class="btn btn-primary px-4">Xác nhận thanh toán</button>
                    </form>
                }
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card card-vt p-4">
                <h2 class="h5">Đặt vé @b.Code</h2>
                @foreach (var t in b.Tickets.Where(t => t.Status == "Active"))
                {
                    <div class="d-flex justify-content-between">
                        <span>Ghế @t.SeatCode - @t.PassengerName</span>
                        <span>@DatVeHelpers.Money(t.Price)</span>
                    </div>
                }
                @if (b.DiscountAmount > 0)
                {
                    <div class="d-flex justify-content-between text-success">
                        <span>Giảm giá</span><span>- @DatVeHelpers.Money(b.DiscountAmount)</span>
                    </div>
                }
                <hr />
                <div class="d-flex justify-content-between fs-5 fw-bold"><span>Tổng cộng</span><span>@DatVeHelpers.Money(b.TotalAmount)</span></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var el = document.getElementById('timer');
            var left = parseInt(el.getAttribute('data-seconds'), 10) || 0;
            function render() {
                var m = Math.floor(left / 60), s = left % 60;
                el.textContent = (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
            }
            render();
            var timer = setInterval(function () {
                left--;
                if (left <= 0) {
                    clearInterval(timer);
                    el.textContent = '00:00';
                    location.reload();   // trang sẽ báo hết giờ và đưa về chọn lại ghế
                    return;
                }
                render();
            }, 1000);
        })();

        // Tự kiểm tra trạng thái mỗi 3 giây; tiền về (webhook ngân hàng) thì chuyển sang trang kết quả
        (function () {
            var url = '/Bookings/@b.Id/Status';
            var timer = setInterval(function () {
                fetch(url, { headers: { 'Accept': 'application/json' } })
                    .then(function (r) { return r.ok ? r.json() : null; })
                    .then(function (d) {
                        if (d && d.status !== 'Holding') {
                            clearInterval(timer);
                            location.href = '/Bookings/@b.Id/Result';
                        }
                    })
                    .catch(function () { });
            }, 3000);
        })();
    </script>
}