@using HeThongVanTai.Web.Models.ViewModels.DanhMuc
@{
    ViewData["Title"] = "Trang chủ";
    var stations = ViewData["Stations"] as List<StationItem> ?? new List<StationItem>();
    var routes = ViewData["PopularRoutes"] as List<RouteItem> ?? new List<RouteItem>();
    var today = DateTime.Today.ToString("yyyy-MM-dd");
}
@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<section class="hero-vt">
    <div class="container text-center">
        <h1 class="display-6 fw-bold">Đặt vé xe khách trực tuyến</h1>
        <p class="lead mb-0">Chọn chuyến, chọn ghế và thanh toán chỉ trong vài bước.</p>
    </div>
</section>

<div class="container search-wrap">
    <form method="get" action="/Trips/Search" class="card card-vt search-card p-4">
        <div class="btn-group mb-3 trip-switch" role="group" aria-label="Loại vé">
            <input type="radio" class="btn-check" name="tripType" id="oneWay" value="oneway" checked>
            <label class="btn btn-outline-primary btn-sm" for="oneWay">Một chiều</label>
            <input type="radio" class="btn-check" name="tripType" id="roundTrip" value="round">
            <label class="btn btn-outline-primary btn-sm" for="roundTrip">Khứ hồi</label>
        </div>
        <div class="row g-3 align-items-end">
            <div class="col-lg">
                <label class="form-label small" for="fromStationId">Điểm đi</label>
                <select class="form-select" id="fromStationId" name="fromStationId" required>
                    <option value="">Chọn điểm đi</option>
                    @foreach (var s in stations)
                    {
                        <option value="@s.Id">@s.Name</option>
                    }
                </select>
            </div>
            <div class="col-auto d-none d-lg-block pb-1">
                <button type="button" class="swap-btn" id="swapStations" aria-label="Đổi điểm đi và điểm đến">
                    <i class="bi bi-arrow-left-right"></i>
                </button>
            </div>
            <div class="col-lg">
                <label class="form-label small" for="toStationId">Điểm đến</label>
                <select class="form-select" id="toStationId" name="toStationId" required>
                    <option value="">Chọn điểm đến</option>
                    @foreach (var s in stations)
                    {
                        <option value="@s.Id">@s.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-6 col-lg-2">
                <label class="form-label small" for="date">Ngày đi</label>
                <input type="date" class="form-control" id="date" name="date" min="@today" value="@today" required />
            </div>
            <div class="col-md-6 col-lg-2 d-none" id="returnWrap">
                <label class="form-label small" for="returnDate">Ngày về</label>
                <input type="date" class="form-control" id="returnDate" name="returnDate" min="@today" value="@today" disabled />
            </div>
            <div class="col-md-6 col-lg-2">
                <label class="form-label small" for="tickets">Số vé</label>
                <input type="number" class="form-control" id="tickets" name="tickets" min="1" max="10" value="1" required />
            </div>
        </div>
        <div class="text-center mt-4">
            <button type="submit" class="btn btn-primary search-submit"><i class="bi bi-search me-1"></i>Tìm chuyến xe</button>
        </div>
    </form>
</div>

<section class="home-section">
    <div class="container">
        <h2 class="home-title">Vì sao chọn VậnTải HK</h2>
        <p class="home-sub">Đặt vé dễ dàng, đi an tâm</p>
        <div class="row g-3">
            <div class="col-md-4">
                <div class="card card-vt h-100 p-4">
                    <div class="feature-icon mb-2"><i class="bi bi-ticket-perforated"></i></div>
                    <h3 class="h6">Đặt vé nhanh</h3>
                    <p class="small mb-0">Tìm chuyến theo điểm đi, điểm đến và ngày, chọn ghế trực quan.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-vt h-100 p-4">
                    <div class="feature-icon mb-2"><i class="bi bi-hourglass-split"></i></div>
                    <h3 class="h6">Giữ chỗ tạm thời</h3>
                    <p class="small mb-0">Ghế được giữ trong thời gian ngắn để bạn hoàn tất thanh toán.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-vt h-100 p-4">
                    <div class="feature-icon mb-2"><i class="bi bi-qr-code"></i></div>
                    <h3 class="h6">Vé điện tử có mã QR</h3>
                    <p class="small mb-0">Nhận vé có mã QR, tra cứu lại bằng mã đặt vé bất kỳ lúc nào.</p>
                </div>
            </div>
        </div>
    </div>
</section>

@if (routes.Count > 0)
{
    <section class="home-section alt">
        <div class="container">
            <h2 class="home-title">Tuyến phổ biến</h2>
            <p class="home-sub">Các điểm đến được yêu thích</p>
            <div class="row g-3">
                @foreach (var r in routes)
                {
                    var hours = r.DurationMin / 60;
                    var mins = r.DurationMin % 60;
                    <div class="col-md-6 col-lg-4">
                        <a class="route-card"
                           href="/Trips/Search?fromStationId=@r.FromStationId&toStationId=@r.ToStationId&date=@today&tickets=1">
                            <div class="from">Từ @(r.FromCity ?? r.FromStationName)</div>
                            <div class="to">@(r.ToCity ?? r.ToStationName)</div>
                            <div class="meta mt-1">
                                <i class="bi bi-signpost-2 me-1"></i>@r.DistanceKm km
                                <i class="bi bi-clock ms-3 me-1"></i>@(hours > 0 ? $"{hours} giờ" : "")@(mins > 0 ? $" {mins} phút" : "")
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </section>
}

<section class="home-section">
    <div class="container">
        <h2 class="home-title">Hướng dẫn đặt vé</h2>
        <p class="home-sub">Bốn bước nhanh gọn</p>
        <div class="row g-3 text-center">
            <div class="col-6 col-md-3"><div class="service-item"><div class="stat-icon"><i class="bi bi-search"></i></div>1. Chọn chuyến</div></div>
            <div class="col-6 col-md-3"><div class="service-item"><div class="stat-icon"><i class="bi bi-grid-3x3-gap"></i></div>2. Chọn ghế</div></div>
            <div class="col-6 col-md-3"><div class="service-item"><div class="stat-icon"><i class="bi bi-credit-card"></i></div>3. Thanh toán</div></div>
            <div class="col-6 col-md-3"><div class="service-item active"><div class="stat-icon"><i class="bi bi-qr-code"></i></div>4. Nhận vé QR</div></div>
        </div>
        <div class="text-center mt-4">
            <a class="btn btn-outline-primary" asp-controller="TraCuuVe" asp-action="Index">Tra cứu vé đã đặt</a>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // Tab Một chiều / Khứ hồi: chỉ gửi returnDate khi chọn khứ hồi
        (function () {
            var wrap = document.getElementById('returnWrap');
            var input = document.getElementById('returnDate');
            var dep = document.getElementById('date');
            function sync() {
                var round = document.getElementById('roundTrip').checked;
                wrap.classList.toggle('d-none', !round);
                input.disabled = !round;
                if (round) { input.min = dep.value; if (input.value < dep.value) input.value = dep.value; }
            }
            document.querySelectorAll('input[name=tripType]').forEach(function (r) { r.addEventListener('change', sync); });
            dep.addEventListener('change', sync);
            sync();
        })();
        document.getElementById('swapStations')?.addEventListener('click', function () {
            const a = document.getElementById('fromStationId');
            const b = document.getElementById('toStationId');
            const t = a.value; a.value = b.value; b.value = t;
        });
    </script>
}