@using HeThongVanTai.Web.Models.ViewModels.Users
@model UserRolesForm
@{
    ViewData["Title"] = "Vai trò - " + Model.Email;
    Layout = "_AdminLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/users.css" asp-append-version="true" />
}

<div class="mb-3">
    <a asp-action="Index" class="small"><i class="bi bi-arrow-left me-1"></i>Người dùng</a>
    <h1 class="h4 mb-0">Vai trò của @Model.Email</h1>
</div>

<div class="card card-vt p-4 form-narrow">
    <form method="post" asp-action="Roles" asp-route-id="@Model.Id">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

        @foreach (var r in RoleLabels.All)
        {
            var checkedNow = Model.SelectedRoles.Contains(r);
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" name="SelectedRoles" value="@r" id="role-@r" checked="@checkedNow" />
                <label class="form-check-label" for="role-@r">
                    @RoleLabels.Of(r) <span class="small text-muted">(@r)</span>
                </label>
            </div>
        }

        <div id="driverProfileBox" class="mt-3 p-3 rounded-3" style="background: var(--vt-soft);" hidden>
            <label class="form-label small mb-1" for="DriverId">Hồ sơ tài xế liên kết <span class="text-danger">*</span></label>
            <select id="DriverId" name="DriverId" class="form-select">
                <option value="">Chọn hồ sơ tài xế</option>
                @foreach (var d in Model.DriverProfiles)
                {
                    <option value="@d.Id" selected="@(Model.DriverId == d.Id)">
                        @d.FullName@(string.IsNullOrWhiteSpace(d.Phone) ? "" : " - " + d.Phone)@(string.IsNullOrWhiteSpace(d.LicenseNo) ? "" : " (GPLX " + d.LicenseNo + ")")
                    </option>
                }
            </select>
            @if (ViewData["DriverProfilesError"] is string dpErr)
            {
                <div class="small text-danger mt-1">@dpErr</div>
            }
            else if (Model.DriverProfiles.Count == 0)
            {
                <div class="small text-muted mt-1">Chưa có hồ sơ tài xế trống. Hãy tạo hồ sơ ở trang Tài xế trước.</div>
            }
            else
            {
                <div class="form-text">Tài xế chỉ thấy chuyến được phân công cho hồ sơ này. Mỗi hồ sơ chỉ liên kết một tài khoản.</div>
            }
        </div>

        @if (Model.IsSelf)
        {
            <p class="small text-muted mt-3 mb-0">Đây là tài khoản của bạn: không thể tự bỏ vai trò Quản trị viên.</p>
        }
        <p class="small text-muted mt-3">Vai trò mới có hiệu lực ở lần đăng nhập sau của người dùng.</p>

        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-primary">Lưu vai trò</button>
            <a class="btn btn-outline-primary" asp-action="Index">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            var cb = document.getElementById('role-Driver');
            var box = document.getElementById('driverProfileBox');
            var sel = document.getElementById('DriverId');
            if (!cb || !box) return;
            function sync() { box.hidden = !cb.checked; sel.required = cb.checked; }
            cb.addEventListener('change', sync);
            sync();
        })();
    </script>
}
