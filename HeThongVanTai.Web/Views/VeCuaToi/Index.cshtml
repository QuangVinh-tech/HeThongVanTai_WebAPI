@using HeThongVanTai.Web.Models.ViewModels.VeKhach
@model MyBookingPage
@{
    ViewData["Title"] = "Vé của tôi";
    var status = ViewData["Status"] as string;
    var loadError = ViewData["LoadError"] as string;
    var totalPages = Model.TotalPages;
    var current = Math.Min(Math.Max(Model.Page, 1), totalPages);
    var pageFrom = Math.Max(1, current - 2);
    var pageTo = Math.Min(totalPages, current + 2);
}

@section Styles {
    <link rel="stylesheet" href="~/css/ve-khach.css" asp-append-version="true" />
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h1 class="h4 mb-0">Vé của tôi</h1>
        <a asp-controller="TraCuuVe" asp-action="Index" class="small">Tra cứu vé bằng mã đặt vé</a>
    </div>

    <div class="status-tabs mb-3">
        <a asp-action="Index" class="status-tab @(string.IsNullOrEmpty(status) ? "active" : "")">Tất cả</a>
        @foreach (var s in VeLabels.BookingStatuses)
        {
            <a asp-action="Index" asp-route-status="@s" class="status-tab @(status == s ? "active" : "")">@VeLabels.Booking(s)</a>
        }
    </div>

    @if (!string.IsNullOrEmpty(loadError))
    {
        <div class="alert alert-danger">@loadError</div>
    }
    else if (Model.Items.Count == 0)
    {
        <div class="card card-vt p-4 text-center">
            <div class="feature-icon mx-auto mb-2"><i class="bi bi-ticket-perforated"></i></div>
            @if (string.IsNullOrEmpty(status))
            {
                <p class="mb-2">Bạn chưa có vé nào.</p>
                <div><a href="/Trips/Search" class="btn btn-primary">Đặt vé ngay</a></div>
            }
            else
            {
                <p class="mb-0">Không có đặt vé nào ở trạng thái "@VeLabels.Booking(status)".</p>
            }
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var b in Model.Items)
            {
                var first = b.Tickets.OrderBy(t => t.DepartAt).FirstOrDefault();
                var seats = string.Join(", ", b.Tickets.Where(t => t.Status != "Cancelled").Select(t => t.SeatCode));
                <a class="card card-vt booking-row text-decoration-none" asp-action="Details" asp-route-code="@b.Code">
                    <div class="p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div>
                            <div class="fw-semibold">@(first == null ? "Đặt vé " + b.Code : first.Route)</div>
                            <div class="small text-muted">
                                Mã @b.Code
                                @if (first != null)
                                {
                                    <span> · Khởi hành @VeLabels.Time(first.DepartAt)</span>
                                }
                            </div>
                            <div class="small text-muted">Ghế: @(string.IsNullOrEmpty(seats) ? "-" : seats)</div>
                        </div>
                        <div class="text-end">
                            <span class="pill @VeLabels.BookingPill(b.Status)">@VeLabels.Booking(b.Status)</span>
                            <div class="fw-semibold mt-1">@VeLabels.Money(b.TotalAmount)</div>
                        </div>
                    </div>
                </a>
            }
        </div>

        @if (totalPages > 1)
        {
            <nav class="mt-3" aria-label="Phân trang">
                <ul class="pagination pagination-sm justify-content-center mb-0">
                    <li class="page-item @(current == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-status="@status" asp-route-page="@(current - 1)">Trước</a>
                    </li>
                    @for (var p = pageFrom; p <= pageTo; p++)
                    {
                        <li class="page-item @(p == current ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-status="@status" asp-route-page="@p">@p</a>
                        </li>
                    }
                    <li class="page-item @(current == totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-status="@status" asp-route-page="@(current + 1)">Sau</a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>
