@using HeThongVanTai.Web.Models.ViewModels.VeKhach
@model MyBookingPage
@{
    ViewData["Title"] = "Vé của tôi";
    var status = ViewData["Status"] as string;
    var loadError = ViewData["LoadError"] as string;
    var totalPages = Model.TotalPages;
    var current = Math.Min(Math.Max(Model.Page, 1), totalPages);
    var pageFrom = Math.Max(1, current - 2);
    var pageTo = Math.Min(totalPages, current + 2);
}

@section Styles {
    <link rel="stylesheet" href="~/css/ve-khach.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ticket.css" asp-append-version="true" />
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h1 class="h4 mb-0">Vé của tôi</h1>
        <a asp-controller="TraCuuVe" asp-action="Index" class="small text-muted">Tra cứu vé bằng mã (không cần đăng nhập)</a>
    </div>

    <div class="status-tabs mb-3">
        <a asp-action="Index" class="status-tab @(string.IsNullOrEmpty(status) ? "active" : "")">Tất cả</a>
        @foreach (var s in VeLabels.BookingStatuses)
        {
            <a asp-action="Index" asp-route-status="@s" class="status-tab @(status == s ? "active" : "")">@VeLabels.Booking(s)</a>
        }
    </div>

    @if (!string.IsNullOrEmpty(loadError))
    {
        <div class="alert alert-danger">@loadError</div>
    }
    else if (Model.Items.Count == 0)
    {
        <div class="card card-vt p-4 text-center">
            <div class="feature-icon mx-auto mb-2"><i class="bi bi-ticket-perforated"></i></div>
            @if (string.IsNullOrEmpty(status))
            {
                <p class="mb-2">Bạn chưa có vé nào.</p>
                <div><a href="/Trips/Search" class="btn btn-primary">Đặt vé ngay</a></div>
            }
            else
            {
                <p class="mb-0">Không có đặt vé nào ở trạng thái "@VeLabels.Booking(status)".</p>
            }
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var b in Model.Items)
            {
                var tickets = b.Tickets.OrderBy(t => t.DepartAt).ToList();
                var first = tickets.FirstOrDefault();
                <div class="card card-vt">
                    <div class="booking-head p-3 d-flex flex-wrap justify-content-between align-items-start gap-2">
                        <div>
                            <div class="fw-semibold">@(first == null ? "Đặt vé " + b.Code : first.Route)</div>
                            <div class="small text-muted">
                                Mã đặt vé <strong>@b.Code</strong> · Đặt lúc @VeLabels.Time(b.CreatedAt)
                            </div>
                        </div>
                        <div class="text-end">
                            <span class="pill @VeLabels.BookingPill(b.Status)">@VeLabels.Booking(b.Status)</span>
                            <div class="fw-semibold mt-1">@VeLabels.Money(b.TotalAmount)</div>
                        </div>
                    </div>
                    <div class="p-3">
                        @if (tickets.Count > 0)
                        {
                            <div class="row g-3">
                                @foreach (var t in tickets)
                                {
                                    var active = t.Status == "Active";
                                    var showQr = active && b.Status == "Paid";
                                    <div class="col-12 col-md-6">
                                        <div class="my-ticket @(active ? "" : "ticket-off")">
                                            <dl class="ticket-info mb-0">
                                                <dt>Khởi hành</dt><dd>@VeLabels.Time(t.DepartAt)</dd>
                                                <dt>Ghế</dt><dd>@t.SeatCode</dd>
                                                <dt>Hành khách</dt><dd>@(string.IsNullOrWhiteSpace(t.PassengerName) ? "-" : t.PassengerName)</dd>
                                                <dt>Mã vé</dt><dd class="fw-semibold">@t.TicketCode</dd>
                                                <dt>Trạng thái</dt><dd><span class="pill @(active ? "pill-ok" : "pill-bad")">@VeLabels.Ticket(t.Status)</span></dd>
                                            </dl>
                                            @if (showQr)
                                            {
                                                <div class="ticket-qr text-center">
                                                    <img src="@Url.Action("Qr", "TraCuuVe", new { ticketCode = t.TicketCode })"
                                                         alt="Mã QR của vé @t.TicketCode" width="96" height="96" loading="lazy" />
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(b.ContactPhone) || b.NeedTransfer)
                        {
                            <div class="small text-muted mt-3 d-flex flex-wrap gap-3">
                                @if (!string.IsNullOrWhiteSpace(b.ContactPhone))
                                {
                                    <span><i class="bi bi-telephone me-1"></i>@b.ContactPhone</span>
                                }
                                @if (b.NeedTransfer)
                                {
                                    <span><i class="bi bi-geo-alt-fill me-1"></i>Trung chuyển: @b.TransferAddress</span>
                                }
                            </div>
                        }

                        <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                            <a class="btn btn-outline-primary btn-sm" asp-action="Details" asp-route-code="@b.Code">Chi tiết</a>
                            @if (b.Status == "Holding")
                            {
                                <a class="btn btn-primary btn-sm" asp-action="Details" asp-route-code="@b.Code">
                                    <i class="bi bi-qr-code me-1"></i>Thanh toán bằng QR
                                </a>
                                @if (b.HoldExpiresAt.HasValue)
                                {
                                    <span class="small text-muted">Giữ ghế đến @VeLabels.Time(b.HoldExpiresAt.Value)</span>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (totalPages > 1)
        {
            <nav class="mt-3" aria-label="Phân trang">
                <ul class="pagination pagination-sm justify-content-center mb-0">
                    <li class="page-item @(current == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-status="@status" asp-route-page="@(current - 1)">Trước</a>
                    </li>
                    @for (var p = pageFrom; p <= pageTo; p++)
                    {
                        <li class="page-item @(p == current ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-status="@status" asp-route-page="@p">@p</a>
                        </li>
                    }
                    <li class="page-item @(current == totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-status="@status" asp-route-page="@(current + 1)">Sau</a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>
