@using HeThongVanTai.Web.Models.ViewModels.VeKhach
@model BookingDetail
@* Thông tin chung của đặt vé: khách, SĐT liên hệ, trung chuyển, thời gian đặt *@
<div class="vt-info-card p-3">
    <h2 class="h6 mb-2">Thông tin đặt vé</h2>
    <div class="vt-info-row">
        <div class="vt-ic"><i class="bi bi-person"></i></div>
        <div><div class="vt-k">Người đặt</div><div class="vt-v">@(string.IsNullOrWhiteSpace(Model.Customer) ? "-" : Model.Customer)</div></div>
    </div>
    <div class="vt-info-row">
        <div class="vt-ic"><i class="bi bi-telephone"></i></div>
        <div><div class="vt-k">Số điện thoại liên hệ</div><div class="vt-v">@(string.IsNullOrWhiteSpace(Model.ContactPhone) ? "Chưa cung cấp" : Model.ContactPhone)</div></div>
    </div>
    <div class="vt-info-row">
        <div class="vt-ic"><i class="bi bi-bus-front"></i></div>
        <div>
            <div class="vt-k">Trung chuyển</div>
            @if (Model.NeedTransfer)
            {
                <div class="vt-v">Có, đón tại: @(string.IsNullOrWhiteSpace(Model.TransferAddress) ? "-" : Model.TransferAddress)</div>
            }
            else
            {
                <div class="vt-v">Không (tự ra bến)</div>
            }
        </div>
    </div>
    <div class="vt-info-row">
        <div class="vt-ic"><i class="bi bi-clock-history"></i></div>
        <div><div class="vt-k">Đặt lúc</div><div class="vt-v">@VeLabels.Time(Model.CreatedAt)</div></div>
    </div>
</div>
