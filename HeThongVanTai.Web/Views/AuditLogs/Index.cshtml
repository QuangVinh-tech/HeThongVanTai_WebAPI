@using HeThongVanTai.Web.Models.ViewModels.NhatKy
@model AuditListModel
@{
    ViewData["Title"] = "Nhật ký thao tác";
    Layout = "_AdminLayout";
    var f = Model.Filter;
    var filtering = !string.IsNullOrWhiteSpace(f.Keyword) || !string.IsNullOrWhiteSpace(f.EntityType)
                    || !string.IsNullOrWhiteSpace(f.Operation) || f.From.HasValue || f.To.HasValue;
    var startPage = Math.Max(1, f.Page - 2);
    var endPage = Math.Min(Model.TotalPages, f.Page + 2);
}

<div class="mb-3">
    <h1 class="h4 mb-0">Nhật ký thao tác</h1>
    <div class="small text-muted">Ai, lúc nào, làm gì, trên dữ liệu nào. Tổng cộng @Model.TotalItems dòng.</div>
</div>

<form method="get" class="filter-xe row g-2 align-items-end mb-3">
    <div class="col-12 col-md-3">
        <label class="form-label small mb-1" for="Keyword">Người làm hoặc nội dung</label>
        <input id="Keyword" name="Keyword" value="@f.Keyword" class="form-control" />
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small mb-1" for="EntityType">Dữ liệu</label>
        <select id="EntityType" name="EntityType" class="form-select">
            <option value="">Tất cả</option>
            @foreach (var e in AuditOptions.EntityTypes)
            {
                <option value="@e.Value" selected="@(f.EntityType == e.Value)">@e.Label</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small mb-1" for="Operation">Thao tác</label>
        <select id="Operation" name="Operation" class="form-select">
            <option value="">Tất cả</option>
            @foreach (var a in AuditOptions.Actions)
            {
                <option value="@a.Value" selected="@(f.Operation == a.Value)">@a.Label</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small mb-1" for="From">Từ ngày</label>
        <input id="From" name="From" type="date" value="@(f.From?.ToString("yyyy-MM-dd"))" class="form-control" />
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small mb-1" for="To">Đến ngày</label>
        <input id="To" name="To" type="date" value="@(f.To?.ToString("yyyy-MM-dd"))" class="form-control" />
    </div>
    <div class="col-12 col-md-1 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-grow-1">Lọc</button>
    </div>
    @if (filtering)
    {
        <div class="col-12"><a class="small" asp-action="Index">Bỏ lọc</a></div>
    }
</form>

@if (!string.IsNullOrEmpty(Model.LoadError))
{
    <div class="alert alert-danger">@Model.LoadError</div>
}

<div class="card card-vt">
    @if (Model.Items.Count == 0)
    {
        <div class="p-4 text-center text-muted">@(filtering ? "Không có dòng nhật ký nào khớp với điều kiện lọc." : "Chưa có thao tác nào được ghi lại.")</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-vt table-hover align-middle mb-0">
                <thead>
                    <tr><th>Thời gian</th><th>Người làm</th><th>Thao tác</th><th>Dữ liệu</th><th>Nội dung</th></tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Items)
                    {
                        <tr>
                            <td class="text-nowrap">@a.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td>@a.UserName</td>
                            <td><span class="pill @AuditOptions.ActionCss(a.Action)">@AuditOptions.ActionText(a.Action)</span></td>
                            <td class="text-nowrap">@AuditOptions.EntityText(a.EntityType)@(string.IsNullOrEmpty(a.EntityId) ? "" : " #" + a.EntityId)</td>
                            <td>@a.Detail</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3" aria-label="Phân trang">
        <ul class="pagination justify-content-center mb-0">
            <li class="page-item @(f.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-Keyword="@f.Keyword" asp-route-EntityType="@f.EntityType" asp-route-Operation="@f.Operation"
                   asp-route-From="@(f.From?.ToString("yyyy-MM-dd"))" asp-route-To="@(f.To?.ToString("yyyy-MM-dd"))" asp-route-Page="@(f.Page - 1)">Trước</a>
            </li>
            @for (var i = startPage; i <= endPage; i++)
            {
                <li class="page-item @(i == f.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-Keyword="@f.Keyword" asp-route-EntityType="@f.EntityType" asp-route-Operation="@f.Operation"
                       asp-route-From="@(f.From?.ToString("yyyy-MM-dd"))" asp-route-To="@(f.To?.ToString("yyyy-MM-dd"))" asp-route-Page="@i">@i</a>
                </li>
            }
            <li class="page-item @(f.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-Keyword="@f.Keyword" asp-route-EntityType="@f.EntityType" asp-route-Operation="@f.Operation"
                   asp-route-From="@(f.From?.ToString("yyyy-MM-dd"))" asp-route-To="@(f.To?.ToString("yyyy-MM-dd"))" asp-route-Page="@(f.Page + 1)">Sau</a>
            </li>
        </ul>
    </nav>
}

@section Styles {
    <link rel="stylesheet" href="~/css/xe-tai-xe.css" asp-append-version="true" />
}
