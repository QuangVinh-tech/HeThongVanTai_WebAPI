@using HeThongVanTai.Web.Models.ViewModels.VanChuyen
@model List<ParcelForm>

<div id="parcelList"></div>
<button type="button" id="btnAddParcel" class="btn btn-outline-primary btn-sm">
    <i class="bi bi-plus-lg me-1"></i>Thêm kiện hàng
</button>

@* Dữ liệu ban đầu của các kiện (khi form báo lỗi, giữ lại những gì đã nhập) *@
<script id="parcelInit" type="application/json">@Json.Serialize(Model)</script>

<template id="parcelTpl">
    <div class="parcel-box">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <strong data-role="title">Kiện hàng</strong>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-outline-primary" data-act="copy"><i class="bi bi-files me-1"></i>Sao chép</button>
                <button type="button" class="btn btn-sm btn-outline-primary" data-act="remove"><i class="bi bi-trash me-1"></i>Xóa</button>
            </div>
        </div>
        <div class="row g-2">
            <div class="col-12 col-md-4">
                <label class="form-label small mb-1">Loại sản phẩm</label>
                <select class="form-select" data-f="goodsType">
                    @foreach (var g in VanChuyenHelpers.GoodsTypes)
                    {
                        <option value="@g.Value">@g.Text</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-8">
                <label class="form-label small mb-1">Tên hàng hóa</label>
                <input type="text" class="form-control" data-f="name" maxlength="200" placeholder="Nhập mô tả hàng hóa" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small mb-1">Trọng lượng (kg)</label>
                <input type="number" class="form-control" data-f="weight" min="0.01" max="1000" step="0.01" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small mb-1">Dài (cm)</label>
                <input type="number" class="form-control" data-f="length" min="0" max="300" step="1" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small mb-1">Rộng (cm)</label>
                <input type="number" class="form-control" data-f="width" min="0" max="300" step="1" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small mb-1">Cao (cm)</label>
                <input type="number" class="form-control" data-f="height" min="0" max="300" step="1" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small mb-1">Khối lượng quy đổi (kg)</label>
                <input type="text" class="form-control" data-f="vol" value="0.00" readonly tabindex="-1" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small mb-1">Số lượng</label>
                <input type="number" class="form-control" data-f="quantity" min="1" max="100" step="1" value="1" />
            </div>
        </div>
    </div>
</template>