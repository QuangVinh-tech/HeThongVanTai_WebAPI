@using HeThongVanTai.Web.Models.ViewModels.KhachHang
@model CustomerListModel
@{
    ViewData["Title"] = "Quản lý khách hàng";
    Layout = "_AdminLayout";
    var startPage = Math.Max(1, Model.Page - 2);
    var endPage = Math.Min(Model.TotalPages, Model.Page + 2);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h4 mb-0">Quản lý khách hàng</h1>
        <div class="small text-muted">Tổng cộng @Model.Total khách hàng</div>
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Thêm khách hàng</a>
</div>

<form method="get" class="filter-xe row g-2 align-items-end mb-3">
    <div class="col-12 col-md-6">
        <label class="form-label small mb-1" for="keyword">Tìm theo tên, số điện thoại hoặc email</label>
        <input id="keyword" name="keyword" value="@Model.Keyword" class="form-control" />
    </div>
    <div class="col-12 col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-grow-1">Tìm</button>
        @if (!string.IsNullOrWhiteSpace(Model.Keyword))
        {
            <a class="btn btn-outline-primary" asp-action="Index">Bỏ lọc</a>
        }
    </div>
</form>

@if (!string.IsNullOrEmpty(Model.LoadError))
{
    <div class="alert alert-danger">@Model.LoadError</div>
}

<div class="card card-vt">
    @if (Model.Items.Count == 0)
    {
        <div class="p-4 text-center text-muted">
            @(string.IsNullOrWhiteSpace(Model.Keyword) ? "Chưa có khách hàng nào." : "Không có khách hàng nào khớp với từ khóa.")
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-vt table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Họ và tên</th>
                        <th>Số điện thoại</th>
                        <th>Email</th>
                        <th>Tài khoản</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@c.FullName</td>
                            <td>@(c.Phone ?? "-")</td>
                            <td>@(c.Email ?? "-")</td>
                            <td>
                                @if (string.IsNullOrEmpty(c.UserId))
                                {
                                    <span class="pill pill-info">Khách quầy</span>
                                }
                                else
                                {
                                    <span class="pill pill-ok">Có tài khoản</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-primary" asp-action="History" asp-route-id="@c.Id">Lịch sử đặt vé</a>
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.Id">Sửa</a>
                                <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline"
                                      data-confirm="@("Xóa khách hàng " + c.FullName + "?")">
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Xóa</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3" aria-label="Phân trang">
        <ul class="pagination justify-content-center mb-0">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-keyword="@Model.Keyword" asp-route-page="@(Model.Page - 1)">Trước</a>
            </li>
            @for (var i = startPage; i <= endPage; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-keyword="@Model.Keyword" asp-route-page="@i">@i</a>
                </li>
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-keyword="@Model.Keyword" asp-route-page="@(Model.Page + 1)">Sau</a>
            </li>
        </ul>
    </nav>
}

@section Styles {
    <link rel="stylesheet" href="~/css/xe-tai-xe.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ConfirmDeleteScript" />
}
