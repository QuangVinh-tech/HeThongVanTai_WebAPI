@using HeThongVanTai.Web.Models.ViewModels.KhachHang
@model CustomerHistoryModel
@{
    ViewData["Title"] = "Lịch sử đặt vé";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h4 mb-0">Lịch sử đặt vé</h1>
        <div class="small text-muted">
            @Model.Customer.FullName
            @if (!string.IsNullOrEmpty(Model.Customer.Phone))
            {
                <text> · @Model.Customer.Phone</text>
            }
            @if (!string.IsNullOrEmpty(Model.Customer.Email))
            {
                <text> · @Model.Customer.Email</text>
            }
        </div>
    </div>
    <a class="btn btn-outline-primary" asp-action="Index">Quay lại danh sách</a>
</div>

@if (!string.IsNullOrEmpty(Model.LoadError))
{
    <div class="alert alert-danger">@Model.LoadError</div>
}

@if (Model.Bookings.Count == 0)
{
    <div class="card card-vt p-4 text-center text-muted">Khách hàng này chưa có đặt vé nào.</div>
}
else
{
    foreach (var b in Model.Bookings)
    {
        <div class="card card-vt mb-3">
            <div class="p-3 d-flex flex-wrap justify-content-between align-items-center gap-2 border-bottom">
                <div>
                    <span class="fw-semibold">@b.Code</span>
                    <span class="small text-muted ms-2">@b.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="fw-semibold">@b.TotalAmount.ToString("N0") đ</span>
                    @if (b.DiscountAmount > 0)
                    {
                        <span class="small text-muted">(đã giảm @b.DiscountAmount.ToString("N0") đ)</span>
                    }
                    <span class="pill @BookingStatusHelper.Css(b.Status)">@BookingStatusHelper.Text(b.Status)</span>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-vt align-middle mb-0">
                    <thead>
                        <tr><th>Mã vé</th><th>Ghế</th><th>Hành khách</th><th>Tuyến</th><th>Khởi hành</th><th>Giá</th><th>Trạng thái</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var t in b.Tickets)
                        {
                            <tr>
                                <td>@t.TicketCode</td>
                                <td>@t.SeatCode</td>
                                <td>@(t.PassengerName ?? "-")</td>
                                <td>@t.Route</td>
                                <td>@t.DepartAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@t.Price.ToString("N0") đ</td>
                                <td><span class="pill @BookingStatusHelper.Css(t.Status)">@BookingStatusHelper.Text(t.Status)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/xe-tai-xe.css" asp-append-version="true" />
}
