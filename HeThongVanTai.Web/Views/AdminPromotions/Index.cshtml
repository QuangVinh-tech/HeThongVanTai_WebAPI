@model HeThongVanTai.Web.Models.ViewModels.DatVe.PromotionsViewModel
@using HeThongVanTai.Web.Models.ViewModels.DatVe
@{
    ViewData["Title"] = "Khuyến mãi";
    Layout = "_AdminLayout";

    (string Text, string Css) State(PromotionItem p)
    {
        var now = DateTime.Now;
        if (!p.IsActive) return ("Đã tắt", "pill-info");
        if (now < p.StartAt) return ("Chưa bắt đầu", "pill-info");
        if (now > p.EndAt) return ("Hết hạn", "pill-warn");
        if (p.UsageLimit.HasValue && p.UsedCount >= p.UsageLimit.Value) return ("Hết lượt", "pill-warn");
        return ("Đang hiệu lực", "pill-ok");
    }
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0">Khuyến mãi</h1>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Thêm mã giảm giá</a>
</div>

<form method="get" class="filter-vt row g-2 align-items-end mb-3">
    <div class="col-12 col-md-6">
        <label class="form-label small mb-1" for="keyword">Tìm theo mã</label>
        <input id="keyword" name="keyword" value="@Model.Keyword" class="form-control" />
    </div>
    <div class="col-12 col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-grow-1">Tìm</button>
        @if (!string.IsNullOrWhiteSpace(Model.Keyword))
        {
            <a class="btn btn-outline-primary" asp-action="Index">Bỏ lọc</a>
        }
    </div>
</form>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<div class="card card-vt">
    @if (Model.Items.Count == 0)
    {
        <div class="p-4 text-center text-muted">
            @(string.IsNullOrWhiteSpace(Model.Keyword) ? "Chưa có mã giảm giá nào." : "Không có mã nào khớp với từ khóa.")
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-vt table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Mã</th>
                        <th>Mức giảm</th>
                        <th class="text-end">Đơn tối thiểu</th>
                        <th>Hiệu lực</th>
                        <th class="text-end">Lượt dùng</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Items)
                    {
                        var st = State(p);
                        <tr>
                            <td class="fw-semibold">@p.Code</td>
                            <td>
                                @if (p.DiscountType == "Percent")
                                {
                                    <span>@p.Value.ToString("0.##")%</span>
                                    @if (p.MaxDiscount.HasValue)
                                    {
                                        <div class="small text-muted">tối đa @DatVeHelpers.Money(p.MaxDiscount.Value)</div>
                                    }
                                }
                                else
                                {
                                    <span>@DatVeHelpers.Money(p.Value)</span>
                                }
                            </td>
                            <td class="text-end">@DatVeHelpers.Money(p.MinOrder)</td>
                            <td>@p.StartAt.ToString("dd/MM/yyyy HH:mm")<div class="small text-muted">đến @p.EndAt.ToString("dd/MM/yyyy HH:mm")</div></td>
                            <td class="text-end">@p.UsedCount / @(p.UsageLimit.HasValue ? p.UsageLimit.Value.ToString() : "không giới hạn")</td>
                            <td><span class="pill @st.Css">@st.Text</span></td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.Id">Sửa</a>
                                <form asp-action="Toggle" asp-route-id="@p.Id" method="post" class="d-inline"
                                      data-confirm="@((p.IsActive ? "Tắt" : "Bật") + " mã " + p.Code + "?")">
                                    <input type="hidden" name="value" value="@((!p.IsActive).ToString().ToLower())" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">@(p.IsActive ? "Tắt" : "Bật")</button>
                                </form>
                                <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline"
                                      data-confirm="@("Xóa mã " + p.Code + "?")">
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Xóa</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Phân trang" class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-keyword="@Model.Keyword" asp-route-page="@(Model.Page - 1)">Trước</a>
            </li>
            @for (var i = Math.Max(1, Model.Page - 2); i <= Math.Min(Model.TotalPages, Model.Page + 2); i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-keyword="@Model.Keyword" asp-route-page="@i">@i</a>
                </li>
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-keyword="@Model.Keyword" asp-route-page="@(Model.Page + 1)">Sau</a>
            </li>
        </ul>
    </nav>
}

@section Scripts {
    <partial name="_ConfirmDeleteScript" />
}