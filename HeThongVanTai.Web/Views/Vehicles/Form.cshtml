@using HeThongVanTai.Web.Models.ViewModels.XeTaiXe
@model VehicleForm
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Thêm xe" : "Sửa xe";
    Layout = "_AdminLayout";
}

<h1 class="h4 mb-3">@ViewData["Title"]</h1>

<div class="card card-vt p-4 form-xe">
    @if (Model.VehicleTypes.Count == 0)
    {
        <div class="alert alert-warning py-2">
            Chưa có loại xe nào. Hãy <a asp-controller="VehicleTypes" asp-action="Create">thêm loại xe</a> trước khi thêm xe.
        </div>
    }
    <form method="post" enctype="multipart/form-data" asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? (int?)null : Model.Id)">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
        <input type="hidden" asp-for="ImageUrl" />
        <div class="row g-3 mb-3">
            <div class="col-12 col-md-6">
                <label asp-for="Plate" class="form-label"></label>
                <input asp-for="Plate" class="form-control" maxlength="20" placeholder="Ví dụ: 49B-123.45" />
                <span asp-validation-for="Plate" class="text-danger small"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="VehicleTypeId" class="form-label"></label>
                <select asp-for="VehicleTypeId" class="form-select">
                    <option value="0">-- Chọn loại xe --</option>
                    @foreach (var t in Model.VehicleTypes)
                    {
                        <option value="@t.Id">@t.Name (@t.SeatCount ghế)</option>
                    }
                </select>
                <span asp-validation-for="VehicleTypeId" class="text-danger small"></span>
            </div>
        </div>
        <div class="row g-3 mb-3">
            <div class="col-12 col-md-4">
                <label asp-for="RegistrationExpiry" class="form-label"></label>
                <input asp-for="RegistrationExpiry" class="form-control" />
                <span asp-validation-for="RegistrationExpiry" class="text-danger small"></span>
            </div>
            <div class="col-12 col-md-4">
                <label asp-for="InsuranceExpiry" class="form-label"></label>
                <input asp-for="InsuranceExpiry" class="form-control" />
                <span asp-validation-for="InsuranceExpiry" class="text-danger small"></span>
            </div>
            <div class="col-12 col-md-4">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select">
                    @foreach (var s in XeTaiXeOptions.Statuses)
                    {
                        <option value="@s.Value">@s.Label</option>
                    }
                </select>
                <span asp-validation-for="Status" class="text-danger small"></span>
            </div>
        </div>
        <div class="mb-4">
            <label asp-for="ImageFile" class="form-label"></label>
            <input asp-for="ImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png" />
            <div class="form-text">Chỉ nhận .jpg, .jpeg, .png, tối đa 5MB. Không chọn ảnh mới thì giữ ảnh hiện tại.</div>
            <span asp-validation-for="ImageFile" class="text-danger small"></span>
            <div class="mt-2">
                <img id="imagePreview" src="@Model.ImageUrl" alt="Ảnh xe" class="preview-xe @(string.IsNullOrEmpty(Model.ImageUrl) ? "d-none" : "")" />
            </div>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Lưu</button>
            <a class="btn btn-outline-primary" asp-action="Index">Hủy</a>
        </div>
    </form>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/xe-tai-xe.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var input = document.getElementById('ImageFile');
            var preview = document.getElementById('imagePreview');
            if (!input || !preview) return;
            input.addEventListener('change', function () {
                var file = input.files && input.files[0];
                if (!file) return;
                preview.src = URL.createObjectURL(file);
                preview.classList.remove('d-none');
            });
        })();
    </script>
}