@model HeThongVanTai.Web.Models.ViewModels.DatVe.AdminBookingsViewModel
@using HeThongVanTai.Web.Models.ViewModels.DatVe
@{
    ViewData["Title"] = "Quản lý đặt vé";
    Layout = "_AdminLayout";
    var f = Model.Filter;
    var result = Model.Result;
    var totalPages = result == null || result.PageSize <= 0 ? 0 : (int)Math.Ceiling(result.Total / (double)result.PageSize);
    var filtering = !string.IsNullOrWhiteSpace(f.Status) || !string.IsNullOrWhiteSpace(f.Keyword)
                    || f.From.HasValue || f.To.HasValue;

    Dictionary<string, string> PageRoute(int p)
    {
        var d = new Dictionary<string, string>
                {
                    ["page"] = p.ToString(),
                    ["desc"] = f.Desc ? "true" : "false"
                };
        if (!string.IsNullOrWhiteSpace(f.Status)) d["status"] = f.Status!;
        if (!string.IsNullOrWhiteSpace(f.Keyword)) d["keyword"] = f.Keyword!;
        if (f.From.HasValue) d["from"] = f.From.Value.ToString("yyyy-MM-dd");
        if (f.To.HasValue) d["to"] = f.To.Value.ToString("yyyy-MM-dd");
        if (!string.IsNullOrWhiteSpace(f.SortBy)) d["sortBy"] = f.SortBy!;
        return d;
    }
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0">Quản lý đặt vé</h1>
    <a class="btn btn-primary" asp-controller="Trips" asp-action="Search"><i class="bi bi-plus-lg me-1"></i>Bán vé tại quầy</a>
</div>

<form method="get" class="filter-vt row g-2 align-items-end mb-3">
    <div class="col-12 col-md-3">
        <label class="form-label small mb-1" for="keyword">Mã đặt vé, tên hoặc SĐT khách</label>
        <input id="keyword" name="keyword" value="@f.Keyword" class="form-control" />
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small mb-1" for="status">Trạng thái</label>
        <select id="status" name="status" class="form-select">
            <option value="" selected="@(string.IsNullOrEmpty(f.Status))">Tất cả</option>
            <option value="Holding" selected="@(f.Status == "Holding")">Chờ thanh toán</option>
            <option value="Paid" selected="@(f.Status == "Paid")">Đã thanh toán</option>
            <option value="Cancelled" selected="@(f.Status == "Cancelled")">Đã hủy</option>
            <option value="Expired" selected="@(f.Status == "Expired")">Hết hạn giữ chỗ</option>
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small mb-1" for="from">Từ ngày</label>
        <input id="from" type="date" name="from" value="@(f.From?.ToString("yyyy-MM-dd"))" class="form-control" />
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small mb-1" for="to">Đến ngày</label>
        <input id="to" type="date" name="to" value="@(f.To?.ToString("yyyy-MM-dd"))" class="form-control" />
    </div>
    <div class="col-6 col-md-3">
        <label class="form-label small mb-1" for="sortBy">Sắp xếp</label>
        <div class="input-group">
            <select id="sortBy" name="sortBy" class="form-select">
                <option value="" selected="@(string.IsNullOrEmpty(f.SortBy))">Ngày đặt</option>
                <option value="total" selected="@(f.SortBy == "total")">Tổng tiền</option>
                <option value="status" selected="@(f.SortBy == "status")">Trạng thái</option>
            </select>
            <select name="desc" class="form-select" aria-label="Thứ tự">
                <option value="true" selected="@(f.Desc)">Giảm dần</option>
                <option value="false" selected="@(!f.Desc)">Tăng dần</option>
            </select>
        </div>
    </div>
    <div class="col-12 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Lọc</button>
        @if (filtering)
        {
            <a class="btn btn-outline-primary" asp-action="Index">Bỏ lọc</a>
        }
    </div>
</form>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<div class="card card-vt">
    @if (result == null || result.Items.Count == 0)
    {
        <div class="p-4 text-center text-muted">
            @(filtering ? "Không có đặt vé nào khớp với điều kiện lọc." : "Chưa có đặt vé nào.")
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-vt table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Mã đặt vé</th>
                        <th>Khách hàng</th>
                        <th class="text-end">Số ghế</th>
                        <th class="text-end">Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th>Ngày đặt</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in result.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@b.Code</td>
                            <td>@b.Customer<div class="small text-muted">@b.Phone</div></td>
                            <td class="text-end">@b.Seats</td>
                            <td class="text-end">@DatVeHelpers.Money(b.TotalAmount)</td>
                            <td><span class="pill @DatVeHelpers.BookingStatusClass(b.Status)">@DatVeHelpers.BookingStatusText(b.Status)</span></td>
                            <td>@(b.CreatedAt?.ToString("HH:mm dd/MM/yyyy"))</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Detail" asp-route-id="@b.Id">Chi tiết</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (result != null && totalPages > 1)
{
    <nav aria-label="Phân trang" class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(result.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-all-route-data="PageRoute(result.Page - 1)">Trước</a>
            </li>
            @for (var p = Math.Max(1, result.Page - 2); p <= Math.Min(totalPages, result.Page + 2); p++)
            {
                <li class="page-item @(p == result.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-all-route-data="PageRoute(p)">@p</a>
                </li>
            }
            <li class="page-item @(result.Page >= totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-all-route-data="PageRoute(result.Page + 1)">Sau</a>
            </li>
        </ul>
    </nav>
}