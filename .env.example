# Sao chép file này thành ".env" rồi sửa giá trị. File .env KHÔNG được đưa lên Git.
# Đây là giá trị mẫu, bắt buộc đổi mật khẩu và khóa trước khi chạy thật.

# --- Cơ sở dữ liệu ---
# Mật khẩu tài khoản sa của SQL Server: tối thiểu 8 ký tự, có chữ hoa, chữ thường, số và ký tự đặc biệt.
# Không dùng dấu chấm phẩy (;) và dấu bằng (=) vì mật khẩu được ghép vào chuỗi kết nối.
MSSQL_SA_PASSWORD=Doi_Mat_Khau_Manh_123!

# --- Tên miền (HTTPS) ---
# Chạy thử trên máy: giữ nguyên localhost và api.localhost.
# Chạy thật: đặt tên miền đã trỏ DNS về máy chủ, ví dụ vantai.example.com và api.vantai.example.com.
WEB_DOMAIN=localhost
API_DOMAIN=api.localhost

# --- Khóa ký token đăng nhập (JWT) ---
# Chuỗi ngẫu nhiên dài ít nhất 32 ký tự. Đổi khóa thì mọi người phải đăng nhập lại.
JWT_KEY=thay-bang-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu

# --- Tài khoản Admin đầu tiên ---
# Tạo khi chạy lần đầu nếu chưa có. Đăng nhập xong hãy đổi mật khẩu ngay (/Account/Profile).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Doi_Mat_Khau_Admin_123

# --- Gửi email (quên mật khẩu, mã xác thực). Bỏ trống SMTP_HOST thì hệ thống không gửi được email ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Thanh toán chuyển khoản ---
# Khóa xác thực webhook SePay: cấu hình cùng giá trị này ở SePay (kiểu xác thực API Key).
SEPAY_WEBHOOK_KEY=
# Tài khoản nhận tiền để tạo mã QR trên trang thanh toán
BANK_ID=MB
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME=
