{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "Properties": { "Application": "HeThongVanTai.Api" },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=VanTaiDB;Trusted_Connection=True;TrustServerCertificate=True;",
    "VanTaiAuthConnection": "Server=(localdb)\\MSSQLLocalDB;Database=VanTaiAuthDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Auth": {
    "RequireEmailConfirmation": true,
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 5,
    "ResetLinkMinutes": 30
  },
  "Web": {
    "BaseUrl": "https://localhost:7300"
  },
  "Security": {
    "AuthRateLimit": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "TrustedProxies": []
  },
  "Email": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "User": "duongvinh1113@gmail.com",
    "From": "duongvinh1113@gmail.com",
    "FromName": "VậnTải HK"
  },
  "Booking": {
    "HoldMinutes": 15
  },
  "Jwt": {
    "Issuer": "https://localhost:7200",
    "Audience": "https://localhost:7200",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Shipping": {
    "PerKm": 150,
    "PerKgStandard": 6000,
    "PerKgExpress": 10000,
    "MinFee": 20000,
    "DoorPickupFee": 10000,
    "DoorDeliveryFee": 15000,
    "FragileRate": 0.2,
    "InsuranceFreeUpTo": 1000000,
    "InsuranceRate": 0.005
  }
}