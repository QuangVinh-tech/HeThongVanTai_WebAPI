@model IEnumerable<HeThongVanTai.Models.Domain.Vehicle>
@{
    ViewData["Title"] = "Quản lý Phương tiện (Xe)";
    var today = DateTime.Today;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container py-4">
    <h2 class="fw-bold text-primary mb-3">Quản lý Xe & Cảnh báo Đăng kiểm / Bảo hiểm</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-dark text-white fw-semibold">Thêm / Cập nhật Xe</div>
        <div class="card-body">
            <form method="post" action="/QuanLyXe/Save" enctype="multipart/form-data" class="row g-3">
                <input type="hidden" name="Id" id="vehicleId" value="0" />
                <div class="col-md-3">
                    <label class="form-label">Biển số xe *</label>
                    <input type="text" name="Plate" id="vehiclePlate" class="form-control" required placeholder="49B-123.45" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Loại xe *</label>
                    <select name="VehicleTypeId" id="vehicleTypeId" class="form-select" asp-items="ViewBag.VehicleTypes" required></select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Hạn đăng kiểm</label>
                    <input type="date" name="RegistrationExpiry" id="regExpiry" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Hạn bảo hiểm</label>
                    <input type="date" name="InsuranceExpiry" id="insExpiry" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Trạng thái</label>
                    <select name="Status" id="vehicleStatus" class="form-select">
                        <option value="Active">Active (Hoạt động)</option>
                        <option value="Maintenance">Maintenance (Bảo dưỡng)</option>
                        <option value="Inactive">Inactive (Ngưng)</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Ảnh phương tiện (.jpg, .png, tối đa 5MB)</label>
                    <input type="file" name="imageFile" class="form-control" accept=".jpg,.jpeg,.png" />
                </div>
                <div class="col-md-6 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary px-4">Lưu thông tin</button>
                    <button type="reset" class="btn btn-secondary" onclick="document.getElementById('vehicleId').value=0">Làm mới</button>
                </div>
            </form>
        </div>
    </div>

    <form method="get" action="/QuanLyXe" class="row g-2 mb-3">
        <div class="col-md-4">
            <input type="text" name="searchPlate" value="@ViewBag.SearchPlate" class="form-control" placeholder="Tìm theo biển số xe..." />
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="Active" selected="@(ViewBag.Status == "Active")">Active</option>
                <option value="Maintenance" selected="@(ViewBag.Status == "Maintenance")">Maintenance</option>
                <option value="Inactive" selected="@(ViewBag.Status == "Inactive")">Inactive</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="sortBy" class="form-select">
                <option value="plate_asc" selected="@(ViewBag.SortBy == "plate_asc")">Sắp xếp: Biển số A-Z</option>
                <option value="plate_desc" selected="@(ViewBag.SortBy == "plate_desc")">Sắp xếp: Biển số Z-A</option>
                <option value="reg_asc" selected="@(ViewBag.SortBy == "reg_asc")">Sắp hết hạn Đăng kiểm</option>
                <option value="ins_asc" selected="@(ViewBag.SortBy == "ins_asc")">Sắp hết hạn Bảo hiểm</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-primary w-100">Lọc dữ liệu</button>
        </div>
    </form>

    <div class="table-responsive bg-white shadow-sm rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Ảnh</th>
                    <th>Biển số</th>
                    <th>Loại xe</th>
                    <th>Hạn đăng kiểm</th>
                    <th>Hạn bảo hiểm</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    int? regDays = item.RegistrationExpiry.HasValue ? (item.RegistrationExpiry.Value.Date - today).Days : null;
                    int? insDays = item.InsuranceExpiry.HasValue ? (item.InsuranceExpiry.Value.Date - today).Days : null;
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" style="width:70px;height:48px;object-fit:cover" class="rounded border" />
                            }
                            else
                            {
                                <span class="badge bg-secondary">Chưa có ảnh</span>
                            }
                        </td>
                        <td class="fw-bold">@item.Plate</td>
                        <td>@item.VehicleType?.Name (@item.VehicleType?.SeatCount ghế)</td>
                        <td>
                            @(item.RegistrationExpiry?.ToString("dd/MM/yyyy") ?? "-")
                            @if (regDays.HasValue && regDays.Value < 0)
                            {
                                <span class="badge bg-danger ms-1">Quá hạn @Math.Abs(regDays.Value) ngày</span>
                            }
                            else if (regDays.HasValue && regDays.Value <= 30)
                            {
                                <span class="badge bg-warning text-dark ms-1">Còn @regDays.Value ngày</span>
                            }
                        </td>
                        <td>
                            @(item.InsuranceExpiry?.ToString("dd/MM/yyyy") ?? "-")
                            @if (insDays.HasValue && insDays.Value < 0)
                            {
                                <span class="badge bg-danger ms-1">Quá hạn @Math.Abs(insDays.Value) ngày</span>
                            }
                            else if (insDays.HasValue && insDays.Value <= 30)
                            {
                                <span class="badge bg-warning text-dark ms-1">Còn @insDays.Value ngày</span>
                            }
                        </td>
                        <td>
                            <span class="badge @(item.Status == "Active" ? "bg-success" : item.Status == "Maintenance" ? "bg-warning text-dark" : "bg-secondary")">
                                @item.Status
                            </span>
                        </td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-warning"
                                    onclick="editVehicle(@item.Id, '@item.Plate', @item.VehicleTypeId, '@(item.RegistrationExpiry?.ToString("yyyy-MM-dd"))', '@(item.InsuranceExpiry?.ToString("yyyy-MM-dd"))', '@item.Status')">
                                Sửa
                            </button>
                            <form method="post" action="/QuanLyXe/Delete/@item.Id" class="d-inline" onsubmit="return confirm('Xác nhận xóa xe này?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (ViewBag.TotalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" href="/QuanLyXe?page=@i&searchPlate=@ViewBag.SearchPlate&status=@ViewBag.Status&sortBy=@ViewBag.SortBy">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

<script>
    function editVehicle(id, plate, typeId, reg, ins, status) {
        document.getElementById('vehicleId').value = id;
        document.getElementById('vehiclePlate').value = plate;
        document.getElementById('vehicleTypeId').value = typeId;
        document.getElementById('regExpiry').value = reg;
        document.getElementById('insExpiry').value = ins;
        document.getElementById('vehicleStatus').value = status;
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }
</script>