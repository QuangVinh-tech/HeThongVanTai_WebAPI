@model IEnumerable<HeThongVanTai.Models.Domain.Driver>
@{
    ViewData["Title"] = "Quản lý Tài xế";
    var today = DateTime.Today;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container py-4">
    <h2 class="fw-bold text-primary mb-3">Quản lý Tài xế & Cảnh báo Hạn GPLX</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-dark text-white fw-semibold">Thêm / Cập nhật Tài xế</div>
        <div class="card-body">
            <form method="post" action="/QuanLyTaiXe/Save" enctype="multipart/form-data" class="row g-3">
                <input type="hidden" name="Id" id="driverId" value="0" />
                <div class="col-md-3">
                    <label class="form-label">Họ và tên *</label>
                    <input type="text" name="FullName" id="fullName" class="form-control" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Số điện thoại</label>
                    <input type="text" name="Phone" id="phone" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Số GPLX</label>
                    <input type="text" name="LicenseNo" id="licenseNo" class="form-control" />
                </div>
                <div class="col-md-1">
                    <label class="form-label">Hạng</label>
                    <input type="text" name="LicenseClass" id="licenseClass" class="form-control" placeholder="E, D" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Hạn GPLX</label>
                    <input type="date" name="LicenseExpiry" id="licenseExpiry" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Trạng thái</label>
                    <select name="Status" id="driverStatus" class="form-select">
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Ảnh đại diện (.jpg, .png, tối đa 5MB)</label>
                    <input type="file" name="avatarFile" class="form-control" accept=".jpg,.jpeg,.png" />
                </div>
                <div class="col-md-6 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary px-4">Lưu Tài xế</button>
                    <button type="reset" class="btn btn-secondary" onclick="document.getElementById('driverId').value=0">Làm mới</button>
                </div>
            </form>
        </div>
    </div>

    <form method="get" action="/QuanLyTaiXe" class="row g-2 mb-3">
        <div class="col-md-6">
            <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="Tìm theo họ tên, SĐT, số GPLX..." />
        </div>
        <div class="col-md-4">
            <select name="status" class="form-select">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="Active" selected="@(ViewBag.Status == "Active")">Active</option>
                <option value="Inactive" selected="@(ViewBag.Status == "Inactive")">Inactive</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-primary w-100">Tìm kiếm</button>
        </div>
    </form>

    <div class="table-responsive bg-white shadow-sm rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Ảnh</th>
                    <th>Họ tên</th>
                    <th>SĐT</th>
                    <th>GPLX / Hạng</th>
                    <th>Hạn GPLX</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    int? daysLeft = d.LicenseExpiry.HasValue ? (d.LicenseExpiry.Value.Date - today).Days : null;
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(d.AvatarUrl))
                            {
                                <img src="@d.AvatarUrl" style="width:48px;height:48px;object-fit:cover" class="rounded-circle border" />
                            }
                            else
                            {
                                <span class="badge bg-secondary">No Avatar</span>
                            }
                        </td>
                        <td class="fw-bold">@d.FullName</td>
                        <td>@d.Phone</td>
                        <td>@d.LicenseNo (@d.LicenseClass)</td>
                        <td>
                            @(d.LicenseExpiry?.ToString("dd/MM/yyyy") ?? "-")
                            @if (daysLeft.HasValue && daysLeft.Value < 0)
                            {
                                <span class="badge bg-danger ms-1">Đã hết hạn</span>
                            }
                            else if (daysLeft.HasValue && daysLeft.Value <= 60)
                            {
                                <span class="badge bg-warning text-dark ms-1">Sắp hết hạn (@daysLeft.Value ngày)</span>
                            }
                        </td>
                        <td>
                            <span class="badge @(d.Status == "Active" ? "bg-success" : "bg-secondary")">@d.Status</span>
                        </td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-warning"
                                    onclick="editDriver(@d.Id, '@d.FullName', '@d.Phone', '@d.LicenseNo', '@d.LicenseClass', '@(d.LicenseExpiry?.ToString("yyyy-MM-dd"))', '@d.Status')">
                                Sửa
                            </button>
                            <form method="post" action="/QuanLyTaiXe/Delete/@d.Id" class="d-inline" onsubmit="return confirm('Xóa tài xế này?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    function editDriver(id, name, phone, licNo, licClass, expiry, status) {
        document.getElementById('driverId').value = id;
        document.getElementById('fullName').value = name;
        document.getElementById('phone').value = phone;
        document.getElementById('licenseNo').value = licNo;
        document.getElementById('licenseClass').value = licClass;
        document.getElementById('licenseExpiry').value = expiry;
        document.getElementById('driverStatus').value = status;
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }
</script>